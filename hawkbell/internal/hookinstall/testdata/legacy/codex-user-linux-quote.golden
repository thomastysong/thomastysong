            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/O'\\''Brien Tools/hawkbell' hook --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/O'\\''Brien Tools/hawkbell' hook --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/O'\\''Brien Tools/hawkbell' hook --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/O'\\''Brien Tools/hawkbell' hook --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/O'\\''Brien Tools/hawkbell' hook --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/O'\\''Brien Tools/hawkbell' hook --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
