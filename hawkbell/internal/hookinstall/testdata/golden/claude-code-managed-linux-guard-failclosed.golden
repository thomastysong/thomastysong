# agent: claude-code
# scope: managed
# path: /etc/claude-code/managed-settings.d/50-hawkbell.json
# action: create
{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/hawkbell",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/hawkbell",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/hawkbell",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/hawkbell",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/hawkbell",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/hawkbell",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/hawkbell",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/hawkbell",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/hawkbell",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/hawkbell",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 10
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/hawkbell",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/hawkbell",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 10
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/hawkbell",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/hawkbell",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/hawkbell",
            "args": ["hook", "--agent", "claude-code"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
