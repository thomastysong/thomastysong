<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  spoor daemon (macOS). Install to /Library/LaunchDaemons/, owned root:wheel,
  mode 0644, then: sudo launchctl bootstrap system /Library/LaunchDaemons/com.github.thomastysong.spoor.plist
  Reading other users' transcripts needs Full Disk Access for /usr/local/bin/spoor,
  granted by an MDM PPPC profile (SystemPolicyAllFiles). UNTESTED on hardware in this release.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.github.thomastysong.spoor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/spoor</string>
    <string>run</string>
    <string>--config</string>
    <string>/Library/Application Support/spoor/spoor.yaml</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>5</integer>
  <key>Umask</key>
  <integer>23</integer>
  <key>ExitTimeOut</key>
  <integer>20</integer>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/spoor/spoor.log</string>
</dict>
</plist>
