# agent: cursor
# scope: user
# path: /C/Users/dev/.cursor/hooks.json
# action: create
{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "C:\\hawkbell\\hawkbell.exe hook --agent cursor",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "C:\\hawkbell\\hawkbell.exe hook --agent cursor",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "C:\\hawkbell\\hawkbell.exe hook --agent cursor",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "C:\\hawkbell\\hawkbell.exe hook --agent cursor",
        "timeout": 10
      }
    ],
    "postToolUseFailure": [
      {
        "command": "C:\\hawkbell\\hawkbell.exe hook --agent cursor",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "C:\\hawkbell\\hawkbell.exe hook --agent cursor",
        "timeout": 10
      }
    ],
    "afterShellExecution": [
      {
        "command": "C:\\hawkbell\\hawkbell.exe hook --agent cursor",
        "timeout": 10
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "C:\\hawkbell\\hawkbell.exe hook --agent cursor",
        "timeout": 10
      }
    ],
    "afterMCPExecution": [
      {
        "command": "C:\\hawkbell\\hawkbell.exe hook --agent cursor",
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "command": "C:\\hawkbell\\hawkbell.exe hook --agent cursor",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": "C:\\hawkbell\\hawkbell.exe hook --agent cursor",
        "timeout": 10
      }
    ],
    "subagentStart": [
      {
        "command": "C:\\hawkbell\\hawkbell.exe hook --agent cursor",
        "timeout": 10
      }
    ],
    "subagentStop": [
      {
        "command": "C:\\hawkbell\\hawkbell.exe hook --agent cursor",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "C:\\hawkbell\\hawkbell.exe hook --agent cursor",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "C:\\hawkbell\\hawkbell.exe hook --agent cursor",
        "timeout": 10
      }
    ]
  }
}
