# agent: cursor
# scope: managed
# path: /C/ProgramData/Cursor/hooks.json
# action: create
{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "if (Test-Path -LiteralPath 'C:\\Program Files\\spoor\\spoor.exe' -PathType Leaf) { & 'C:\\Program Files\\spoor\\spoor.exe' hook --agent cursor; exit $LASTEXITCODE } else { exit 0 }",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "& 'C:\\Program Files\\spoor\\spoor.exe' hook --agent cursor",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "& 'C:\\Program Files\\spoor\\spoor.exe' hook --agent cursor",
        "timeout": 10,
