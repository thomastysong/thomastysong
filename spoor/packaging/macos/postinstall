#!/bin/sh
# spoor macOS installer package post-install script (pkgbuild --scripts).
# UNTESTED on macOS hardware in this release: written to match
# deploy/fleet/scripts/install-spoor.sh (macOS branch), which is also
# unexercised on macOS; `sh -n` and the shared logic are checked on Linux.
#
# The payload put /usr/local/bin/spoor and
# /Library/LaunchDaemons/com.github.thomastysong.spoor.plist in place. This
# script:
#  1. creates the spoor group (outbox readers) when it is missing;
#  2. creates /Library/Application Support/spoor (configuration and data,
#     root:wheel 0755; the daemon tightens what it creates inside) and
#     /Library/Logs/spoor, which the plist's StandardErrorPath names and
#     launchd does not create (without it the daemon's stderr is lost);
#  3. writes spoor.yaml with `spoor export config` when there is none;
#  4. refreshes the osquery extension copy when spoor is registered in
#     /var/osquery/extensions.load, and restarts osquery detached;
#  5. (re)loads the launchd job so the new binary runs;
#  6. rewrites spoor's managed hook entries that are exactly what an
#     earlier release wrote with install's default options (they report
#     "modified" until then); entries installed with other options (--guard
#     --fail-closed, --timeout) or edited are left as they are and reported,
#     because a rewrite with default options would silently undo them.
# Reading other users' transcripts needs Full Disk Access for
# /usr/local/bin/spoor, granted by an MDM PPPC profile (SystemPolicyAllFiles).
set -eu

# $3 is the target volume ("/" for the boot volume).
ROOT=${3:-/}
ROOT=${ROOT%/}
BIN=$ROOT/usr/local/bin/spoor
CONF_DIR="$ROOT/Library/Application Support/spoor"
CONF=$CONF_DIR/spoor.yaml
LOGS=$ROOT/Library/Logs/spoor
LABEL=com.github.thomastysong.spoor
PLIST=$ROOT/Library/LaunchDaemons/$LABEL.plist
EXT_DIR=$ROOT/usr/local/lib/spoor
EXT=$EXT_DIR/spoor.ext
LOAD=$ROOT/var/osquery/extensions.load

warn() { echo "spoor: warning: $*" >&2; }

# 1. Group.
if ! dseditgroup -o read spoor >/dev/null 2>&1; then
	dseditgroup -o create -r "spoor outbox readers" spoor
fi

# 2. Directories.
for d in "$CONF_DIR" "$LOGS"; do
	if [ -L "$d" ]; then
		echo "spoor: $d is a symbolic link; refusing to use it" >&2
		exit 1
	fi
	mkdir -p "$d"
	chown root:wheel "$d"
	chmod 0755 "$d"
done

# 3. Configuration.
if [ ! -e "$CONF" ] && [ ! -L "$CONF" ]; then
	if "$BIN" export config --out "$CONF" >/dev/null 2>&1; then
		chown root:wheel "$CONF"
		chmod 0644 "$CONF"
	else
		warn "could not write $CONF; the daemon runs with built-in defaults"
	fi
fi

# 4. osquery extension copy (osquery runs a root-owned copy named *.ext).
if [ -f "$LOAD" ] && grep -qxF "$EXT" "$LOAD"; then
	if ! cmp -s "$BIN" "$EXT" 2>/dev/null; then
		mkdir -p "$EXT_DIR"
		chown root:wheel "$EXT_DIR"
		chmod 0755 "$EXT_DIR"
		cp "$BIN" "$EXT.new" && chown root:wheel "$EXT.new" && chmod 0755 "$EXT.new" && mv -f "$EXT.new" "$EXT"
		svc=system/com.facebook.osqueryd
		launchctl print system/com.fleetdm.orbit >/dev/null 2>&1 && svc=system/com.fleetdm.orbit
		# Detached: a package installed by orbit must report before orbit restarts.
		nohup sh -c "sleep 10; launchctl kickstart -k $svc" >/dev/null 2>&1 &
		echo "spoor: osquery ($svc) restarts in 10 s to load $EXT"
	fi
fi

# 5. launchd job.
chown root:wheel "$PLIST"
chmod 0644 "$PLIST"
if [ "$ROOT" = "" ]; then
	launchctl bootout "system/$LABEL" >/dev/null 2>&1 || true
	launchctl bootstrap system "$PLIST" || warn "launchctl bootstrap failed; see /Library/Logs/spoor/spoor.log"
fi

# 6. Hooks (see packaging/linux/postinstall.sh for the parsing and the
# selection).
sel=$("$BIN" hooks status --scope managed --json 2>/dev/null | awk -F'"' '
	function flush() {
		if (a != "" && old && !(a in seen)) {
			seen[a] = 1
			out = out (out == "" ? "" : ",") a
		} else if (a != "" && !old && s == "modified" && !(a in kept)) {
			kept[a] = 1
			left = left (left == "" ? "" : ",") a
		}
		a = ""
		s = ""
		old = 0
	}
	/^[ \t]*"agent": "/ { flush(); a = $4 }
	/^[ \t]*"status": "/ { s = $4 }
	/^[ \t]*"detail": "/ {
		d = $4
		if (index(d, "written by an earlier spoor release") == 1 || index(d, "; written by an earlier spoor release") > 0) old = 1
	}
	END { flush(); print out; print left }') || sel=""
hooked=$(printf '%s\n' "$sel" | sed -n 1p)
left=$(printf '%s\n' "$sel" | sed -n 2p)
if [ -n "$hooked" ]; then
	if "$BIN" hooks install --scope managed --agents "$hooked" >/dev/null 2>&1; then
		echo "spoor: managed hooks rewritten for $hooked"
	else
		warn "could not rewrite managed hooks for $hooked; run: $BIN hooks install --scope managed --agents $hooked"
	fi
fi
if [ -n "$left" ]; then
	echo "spoor: managed hooks of $left left as they are: they differ from install's default options (--guard, --fail-closed, --timeout ...) or were edited; if an earlier release wrote them, run $BIN hooks install --scope managed --agents $left with the options they were installed with"
fi
exit 0
