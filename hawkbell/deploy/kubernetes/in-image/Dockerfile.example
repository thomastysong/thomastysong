# In-image hook mode: add hawkbell to a development or agent image you build.
# README.md ("In-image hook mode") says what it gives and what it does not;
# test/e2e/container_test.go (TestContainerInImageHookMode) runs this layout.
#
# Use the BARE binary (release download, or `docker build --target binary`),
# never /usr/bin/hawkbell from the node sensor image: that copy carries file
# capabilities and does not start in a container without SYS_PTRACE and
# DAC_READ_SEARCH.

FROM your-base-image

# 1. The binary, verified against the release's checksums.txt.
ARG HAWKBELL_VERSION=0.1.0
ARG HAWKBELL_SHA256=<sha256 of hawkbell_linux_amd64 from checksums.txt>
ADD --checksum=sha256:${HAWKBELL_SHA256} \
    https://downloads.example.com/hawkbell/${HAWKBELL_VERSION}/hawkbell_linux_amd64 /usr/local/bin/hawkbell
RUN chmod 0755 /usr/local/bin/hawkbell

# 2. Managed hooks for the agents in this image (root-owned policy files the
#    workspace user cannot edit), a small configuration, and a data
#    directory owned by the user the daemon runs as (here uid 1000).
RUN /usr/local/bin/hawkbell hooks install --scope managed --binary /usr/local/bin/hawkbell \
      --agents claude-code,codex,gemini-cli,copilot-cli \
 && install -d -m 0755 /etc/hawkbell /usr/local/share/hawkbell \
 && printf 'data_dir: /var/lib/hawkbell\noutput:\n  stdout: true\n' > /etc/hawkbell/hawkbell.yaml \
 && chmod 0644 /etc/hawkbell/hawkbell.yaml \
 && install -d -m 0700 -o 1000 -g 1000 /var/lib/hawkbell
COPY hawkbell-entrypoint.sh /usr/local/share/hawkbell/hawkbell-entrypoint.sh
RUN chmod 0755 /usr/local/share/hawkbell/hawkbell-entrypoint.sh

USER 1000
# With a read-only root file system, mount a writable volume (emptyDir) at
# /var/lib/hawkbell owned by that user (fsGroup or an init step).
ENTRYPOINT ["/usr/local/share/hawkbell/hawkbell-entrypoint.sh"]
CMD ["sleep", "infinity"]
