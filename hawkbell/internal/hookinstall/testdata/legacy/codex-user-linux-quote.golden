          {
            "type": "command",
            "command": "'/opt/O'\\''Brien Tools/hawkbell' hook --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/opt/O'\\''Brien Tools/hawkbell' hook --agent codex",
            "timeout": 10,
