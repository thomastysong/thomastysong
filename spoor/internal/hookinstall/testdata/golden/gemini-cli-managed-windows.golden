# agent: gemini-cli
# scope: managed
# path: /C/ProgramData/gemini-cli/settings.json
# action: create
{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "spoor",
            "type": "command",
            "command": "if (Test-Path -LiteralPath 'C:\\Program Files\\spoor\\spoor.exe' -PathType Leaf) { & 'C:\\Program Files\\spoor\\spoor.exe' hook --agent gemini-cli; exit $LASTEXITCODE } else { exit 0 }",
            "timeout": 10000
          }
        ]
      }
    ],
