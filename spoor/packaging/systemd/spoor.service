# spoor daemon (Linux). Installed by the deb/rpm packages to
# /usr/lib/systemd/system/spoor.service.
#
# The daemon runs as root because it must read every user's agent
# transcripts and process information and hand each user a private spool
# directory. The hardening below takes away what it does not need: it can
# read the whole file system but write only its own state, runtime and
# configuration-free directories, and it keeps only the capabilities listed.
[Unit]
Description=spoor AI agent detection sensor
Documentation=https://github.com/thomastysong/thomastysong/tree/main/spoor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/spoor run --config /etc/spoor/spoor.yaml
Restart=always
RestartSec=5s
# Flush on SIGTERM; systemd waits this long before SIGKILL.
TimeoutStopSec=20s

# /var/lib/spoor (state, outbox, spools) and /run/spoor.
StateDirectory=spoor
StateDirectoryMode=0750
RuntimeDirectory=spoor
RuntimeDirectoryMode=0755
UMask=0027

# Read-only view of the system and of home directories (transcripts, agent
# configuration); writes only where listed.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/spoor /run/spoor
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# AF_NETLINK for the process connector; AF_UNIX for osquery's extension
# socket; AF_INET/6 for bundle pulls and the optional shippers.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# CAP_DAC_READ_SEARCH: read transcripts in 0700 home directories.
# CAP_SYS_PTRACE: read /proc/<pid>/{exe,cwd,environ} of other users' agents.
# CAP_NET_ADMIN: subscribe to the netlink process connector.
# CAP_CHOWN, CAP_FOWNER: create each user's private spool directory.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_NET_ADMIN CAP_CHOWN CAP_FOWNER
AmbientCapabilities=
# Lower priority than interactive work.
Nice=5
IOSchedulingClass=idle
CPUWeight=50
MemoryHigh=256M
MemoryMax=512M

[Install]
WantedBy=multi-user.target
